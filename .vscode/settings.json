{
  "pasteImage.path": "${projectRoot}/attachments",
  "pasteImage.defaultName": "Y-MM-DD-HH-mm-ss",
  "pasteImage.namePrefix": "${currentFileNameWithoutExt}__",
  "pasteImage.insertPattern": "![${imageFileNameWithoutExt}](${imageFilePath})",
  "pasteImage.showFilePathConfirmInputBox": false,

  /** If you want the generated path to be a relative path (more universal) **/
  "pasteImage.basePath": "${currentFileDir}",
  "pasteImage.prefix": "",

  /** Or you want the generated path to be a root path **/
  // "pasteImage.basePath": "${projectRoot}",
  // "pasteImage.prefix": "/",
}
